# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
dist/
build/

# Tooling caches
.pytest_cache/
.ruff_cache/

# Local-only Claude settings (MCP config may hold credentials; copy .mcp.json.example)
.claude/settings.local.json
.mcp.json

# Per-checkout pointer to the workspace + default project (`greenhouse workspace use`)
greenhouse.local.toml

# OS noise
.DS_Store

# Spec projects live in a workspace outside this repo (`greenhouse workspace
# use <path>`). projects/ is only the zero-config fallback workspace and is
# never committed here — keep the tooling shareable.
/projects/*
!/projects/README.md
